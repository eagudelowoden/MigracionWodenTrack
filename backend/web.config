<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config del sitio IIS que sirve el frontend + hace de reverse proxy al
  backend NestJS (puerto 3001).

  Regla "ReverseProxyToBackend": lista explícita de los prefijos/rutas reales
  que expone el backend (ver @Controller(...) en backend/src). Dos bugs
  corregidos acá:

  1. "apk/.*" exigía una barra después de "apk", pero @Controller('apk') con
     @Delete() (sin sufijo) expone la ruta EXACTA "/apk" — sin barra ni nada
     después. Esa ruta nunca hacía match, caía al fallback de SPA (regla 4),
     IIS intentaba servir index.html como archivo estático, y el manejador
     de archivos estáticos de IIS no permite DELETE → 405 Method Not Allowed,
     con headers de IIS (no de Express) — aunque el endpoint en NestJS
     estuviera perfectamente implementado. Fix: "apk(/.*)?" — la barra y el
     sufijo pasan a ser opcionales.
  2. Faltaba "estructura-organizacional/.*" por completo — ese módulo
     (segmentación + centros de costo) nunca llegaba al backend en este
     ambiente.

  Si agregas un @Controller nuevo con un prefijo en la raíz (no bajo
  "usuarios/..."), o un @Get/@Post nuevo en app.controller.ts sin subruta,
  hay que sumarlo aquí también — mismo patrón que causó el bug del punto 1.
-->
<configuration>
  <system.webServer>

    <!-- Habilita WebSockets para Socket.io -->
    <webSocket enabled="true" />

    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="no-cache, no-store, must-revalidate" />
        <add name="Pragma" value="no-cache" />
        <add name="Expires" value="-1" />
      </customHeaders>
    </httpProtocol>

    <rewrite>
      <rules>
        <!-- 1. Modo Mantenimiento -->
        <rule name="Modo Mantenimiento" enabled="false" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{SCRIPT_NAME}" pattern="^/mantenimiento.html" negate="true" />
            <add input="{REQUEST_FILENAME}" pattern=".*\.js|.*\.css|.*\.png|.*\.jpg|.*\.svg" negate="true" />
            <add input="{REMOTE_ADDR}" pattern="152.200.241.168" negate="true" />
          </conditions>
          <action type="Rewrite" url="/mantenimiento.html" />
        </rule>

        <!-- 2. Reverse Proxy para WebSockets (Socket.io) -->
        <rule name="WebSocketProxy" stopProcessing="true">
          <match url="socket.io/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3001/socket.io/{R:1}" />
        </rule>

        <!--
          3. Reverse Proxy para la API (backend NestJS en puerto 3001).
          Prefijos con subrutas: usuarios, dashboard-asistencia, apk,
          modulos-disponibles, estructura-organizacional, uploads — "apk" con
          "(/.*)?" para cubrir también la ruta exacta "/apk" (sin barra).
          Rutas EXACTAS en la raíz (definidas en app.controller.ts, sin
          subruta): version, entorno, mantenimiento.
        -->
        <rule name="ReverseProxyToBackend" stopProcessing="true">
          <match url="^(usuarios/.*|dashboard-asistencia/.*|apk(/.*)?|modulos-disponibles/.*|estructura-organizacional/.*|uploads/.*|version|entorno|mantenimiento)$" />
          <action type="Rewrite" url="http://127.0.0.1:3001/{R:0}" />
        </rule>

        <!-- 4. SPA Fallback (History Mode para Frontend) -->
        <rule name="Handle History Mode" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>
</configuration>
